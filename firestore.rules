rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveMember() {
      return signedIn() && request.auth.token.accountActive == true;
    }

    function isModerator() {
      return signedIn()
        && (request.auth.token.admin == true || request.auth.token.moderator == true);
    }

    match /users/{uid} {
      allow read: if signedIn() && (isOwner(uid) || isModerator());
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'bio', 'updatedAt', 'privacy']);
      allow delete: if false;

      match /blocks/{targetUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.keys().hasOnly(['targetUid', 'createdAt'])
          && request.resource.data.targetUid == targetUid;
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /saved/{postId} {
        allow read: if isOwner(uid);
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published'
        || (signedIn()
          && (resource.data.authorId == request.auth.uid || isModerator()));
      allow create: if isActiveMember()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'mediaType', 'createdAt',
          'visibility', 'status'
        ])
        && request.resource.data.status == 'pending_review'
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video'];
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['caption', 'updatedAt']);
      allow delete: if false;

      match /likes/{uid} {
        allow read: if resource.data != null;
        allow create: if isActiveMember() && isOwner(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'createdAt']);
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if resource.data.status == 'approved'
          || (signedIn() && isModerator());
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt', 'status'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.status == 'pending_review';
        allow update, delete: if false;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'targetId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.targetId
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(request.resource.data.targetId))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)/blocks/$(request.auth.uid));
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId', 'postId', 'reason', 'createdAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300;
      allow read: if isModerator();
      allow update, delete: if false;
    }

    match /moderation_audit/{entryId} {
      allow read: if isModerator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}